{
  "name": "recruitment-ats-factory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "predev": "node scripts/write-version.js",
    "dev": "vite",
    "prebuild": "node scripts/write-version.js",
    "build": "vite build",
    "builder": "node builder/server.mjs",
    "generate": "node builder/generate.mjs",
    "setup": "npm ci && npm --prefix server ci",
    "local": "node scripts/platform-dev.mjs",
    "config:validate": "node builder/validate-config.mjs",
    "test": "node --test config/*.test.js src/**/*.test.js",
    "test:platform": "node --test builder/*.test.cjs tests/platform.acceptance.test.cjs shared/ats-config.test.cjs server/src/platform/*.test.js",
    "test:generated": "node scripts/generated-matrix.mjs",
    "test:browser": "node scripts/browser-acceptance.mjs",
    "backup:create": "node scripts/deployment-backup.mjs backup",
    "backup:preview": "node scripts/deployment-backup.mjs preview",
    "backup:restore": "node scripts/deployment-backup.mjs restore --replace",
    "lint": "eslint .",
    "preview": "vite preview",
    "seed:demo": "node server/scripts/seed-demo.js",
    "invoice:reset": "node server/scripts/reset-invoice-sequence.js",
    "invoice:visual": "node server/scripts/invoice-visual-regression.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "1.63.0",
    "vite": "^8.0.12"
  }
}
